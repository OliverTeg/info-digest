# ===== Kimi (Moonshot AI) 配置 =====
# 必填：你的 Kimi API Key
# 获取地址：https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=sk-your-key-here

# 可选：使用的模型（默认 moonshot-v1-8k）
# moonshot-v1-8k    — 适合短文章，最便宜
# moonshot-v1-32k   — 适合中等长度文章
# moonshot-v1-128k  — 适合超长文章
KIMI_MODEL=moonshot-v1-8k

# ===== 摘要设置 =====
SUMMARY_LANGUAGE=中文
SUMMARY_MAX_LENGTH=300
AUTO_SUMMARIZE=false
