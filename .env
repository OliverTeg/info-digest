# ===== Kimi (Moonshot AI) 配置 =====
# 将下方 sk-your-key-here 替换成你的真实 API Key
# 获取地址：https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=sk-wuf91xTSG8hB2mW2wQfiVzyzU2OeBaLIFY8UVf1pN1ZaVbaw

# 使用的模型
KIMI_MODEL=moonshot-v1-8k

# ===== 摘要设置 =====
SUMMARY_LANGUAGE=中文
SUMMARY_MAX_LENGTH=300
AUTO_SUMMARIZE=false

# ===== RSSHub 实例地址 =====
# 公共实例 rsshub.app 有 Cloudflare 人工验证，本地自建可彻底解决
# 自建命令：docker run -d -p 1200:1200 diygod/rsshub
RSSHUB_BASE=http://localhost:1200
